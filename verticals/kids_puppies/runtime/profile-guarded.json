      "schema_version": "1.0.0",
      "provider_id": "kids-reference-visuals",
      "adapter": "openai-reference-image",
      "capabilities": [
        "visual.image.reference"
      ],
      "secret_refs": [
        {
          "schema_version": "1.0.0",
          "scheme": "env",
          "key": "OPENAI_API_KEY"
        }
      ],
      "options": {
        "response_model": "gpt-6-astra",
        "image_model": "gpt-image-2.5-sunburst",
        "image_quality": "low",
        "image_size": "1024x1536",
        "cost_per_generation_usd": 0.1,
        "output_dir": "generated/kids_puppies/runtime/visuals",
        "reference_catalog_path": "verticals/kids_puppies/consistency/reference_catalog.json"
      },
      "external_calls_enabled": false,
      "paid_calls_enabled": false,
      "max_stage_cost_usd": 10,
      "metadata": {
        "vertical": "kids_puppies",
        "original_ip": true,
        "default_deny": true,
        "requires_materialized_references": true
      }
    },
    {
      "schema_version": "1.0.0",
      "provider_id": "kids-media",
      "adapter": "mpt-media",
      "capabilities": [
        "media.assembly"
      ],
      "secret_refs": [],
      "options": {
        "estimated_cost_usd": 0,
        "voice_name": "es-CO-SalomeNeural-Female",
        "output_uri_template": "generated/kids_puppies/{episode_id}/r{revision}/master.mp4",
        "subtitle_enabled": true,
        "work_dir": "generated/kids_puppies/runtime/media"
      },
      "external_calls_enabled": false,
      "paid_calls_enabled": false,
      "max_stage_cost_usd": 0.5,
      "metadata": {
        "vertical": "kids_puppies",
        "original_ip": true,
        "default_deny": true,
        "voice_provider": "microsoft-edge-tts",
        "voice_locale": "es-CO"
      }
    }
  ],
  "stage_bindings": {
    "visuals": "kids-reference-visuals",
    "media": "kids-media"
  },
  "metadata": {
    "vertical": "kids_puppies",
    "original_ip": true,
    "child_safe": true,
    "default_deny": true,
    "pilot_cost_ceiling_usd": 10,
    "live_publication": false
  }
