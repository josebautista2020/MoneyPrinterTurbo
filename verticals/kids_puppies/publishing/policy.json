{
  "schema_version": "1.0.0",
  "policy_id": "kids-puppies-publishing-v1",
  "allowed_targets": [
    {
      "schema_version": "1.0.0",
      "platform": "youtube",
      "account_ref": "kids-demo-channel"
    },
    {
      "schema_version": "1.0.0",
      "platform": "instagram",
      "account_ref": "kids-demo-channel"
    }
  ],
  "live_publish_enabled": false,
  "max_targets_per_request": 2,
  "require_latest_approval": true,
  "require_explicit_youtube_audience": true,
  "require_synthetic_media_declaration": true,
  "metadata": {
    "vertical": "kids_puppies",
    "audience": "4-9",
    "default_deny": true,
    "human_approval_required": true
  },
  "max_live_publications_per_hour": 1
}
